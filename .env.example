# === Wajib (Supabase & App) ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === Keamanan Kredensial Remote (AES-256-GCM, 32-byte / 64 hex atau passphrase panjang) ===
REMOTE_CREDENTIAL_ENCRYPTION_KEY=replace-with-64-hex-characters-or-long-random-secret

# === Rate Limiting (Upstash Redis di Vercel, atau memory di on-prem single-node) ===
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
# RATE_LIMIT_BACKEND=memory
RATE_LIMIT_TIKET_PUBLIK=20
RATE_LIMIT_TIKET_DARURAT=100

# === Telegram Bot & Cron ===
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username
CRON_SECRET=replace-with-a-long-random-secret

# === Opsional: Notifikasi Email & AI Self-Check ===
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM=IT Support <it@debito.local>
# EMAIL_WEBHOOK_URL=
# GEMINI_API_KEY=
